---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Ydelser">
  <section class="hero">
    <div class="container">
      <h1>Vores ydelser</h1>
      <p>Vi tilbyder dronefotografering, dronevideo og droneinspektion til private og erhverv i hele Jylland.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="services">
        <div class="service">
          <h3>Dronefotografi</h3>
          <p>Luftbilleder til begivenheder, ejendomme og byggeprojekter.</p>
          <a href="/ydelser/dronefotografi">Læs mere →</a>
        </div>
        <div class="service">
          <h3>Dronevideo & dronefilm</h3>
          <p>Færdigredigerede dronevideoer i 4K kvalitet.</p>
          <a href="/ydelser/dronevideo">Læs mere →</a>
        </div>
        <div class="service">
          <h3>Droneinspektion</h3>
          <p>Inspektion af tage, tagrender, skorstene og telemaster.</p>
          <a href="/ydelser/droneinspektion">Læs mere →</a>
        </div>
        <div class="service">
          <h3>Inspektion af landbrug</h3>
          <p>Overflyvninger af marker og landbrug for at spotte problemområder.</p>
          <a href="/ydelser/inspektion-af-landbrug">Læs mere →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
