---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Dronefoto Aarhus – dronefotografering, dronevideo og droneinspektion i Aarhus & Østjylland. Certificerede dronepiloter." } = Astro.props;
---

<!doctype html>
<html lang="da">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Dronefoto Aarhus</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={`https://dronefotoaarhus.dk${Astro.url.pathname}`} />
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{--blue:#0f3a5f;--blue-dk:#0b2c47;--sky:#3b82c4;--accent:#e8912d;--bg:#f5f7fa;--surface:#fff;--text:#1c2a38;--muted:#5c6b7d;--border:#e0e6ec}
    html{scroll-behavior:smooth}
    body{font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.65}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;height:auto;display:block}
    .container{width:100%;max-width:1100px;margin:0 auto;padding:0 1.25rem}

    .site-header{position:sticky;top:0;z-index:100;background:var(--blue);color:#fff}
    .header-inner{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.25rem;max-width:1100px;margin:0 auto;gap:1rem}
    .logo{font-size:1.15rem;font-weight:800;letter-spacing:-.01em}
    .logo span{color:var(--accent)}
    nav{display:flex;gap:1.5rem;align-items:center}
    nav a{color:rgba(255,255,255,.85);font-size:.95rem;font-weight:600;transition:color .15s}
    nav a:hover{color:#fff}
    .nav-cta{background:var(--accent);color:#fff!important;padding:.6rem 1.25rem;border-radius:8px;font-weight:700}
    .nav-cta:hover{background:#d67f1d}
    .nav-toggle{display:none;background:none;border:none;cursor:pointer;color:#fff;padding:.5rem}
    .mobile-menu{display:none;background:var(--blue-dk);padding:1rem 1.25rem}
    .mobile-menu.open{display:block}
    .mobile-menu a{display:block;padding:.75rem 0;font-weight:600;border-bottom:1px solid rgba(255,255,255,.12);color:#fff}
    @media(max-width:768px){nav{display:none}.nav-toggle{display:block}}

    .btn{display:inline-block;background:var(--accent);color:#fff;padding:.85rem 1.75rem;border-radius:8px;font-weight:700;font-size:1rem;transition:background .15s;border:none;cursor:pointer}
    .btn:hover{background:#d67f1d}
    .btn-outline{background:transparent;border:2px solid #fff;color:#fff}
    .btn-outline:hover{background:#fff;color:var(--blue)}

    .hero{background:linear-gradient(135deg,var(--blue-dk),var(--blue));color:#fff;padding:4rem 0}
    .hero h1{font-size:clamp(2rem,5vw,3rem);font-weight:800;line-height:1.15;margin-bottom:1rem}
    .hero p{font-size:clamp(1rem,2vw,1.2rem);color:rgba(255,255,255,.92);max-width:680px;margin-bottom:1.75rem}
    .section{padding:3.5rem 0}
    .section h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:800;margin-bottom:1rem;color:var(--text)}
    .section .lead{color:var(--muted);max-width:700px;margin-bottom:2rem}

    .services{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:2rem}
    .service{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:2rem}
    .service h3{font-size:1.25rem;font-weight:800;color:var(--blue);margin-bottom:.75rem}
    .service p{font-size:.95rem;margin-bottom:1rem}
    .service a{color:var(--sky);font-weight:700}

    .gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1rem;margin-top:2rem}
    .gallery img{border-radius:10px;width:100%;aspect-ratio:16/10;object-fit:cover}

    .quals{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.5rem;text-align:center}
    .qual .big{font-size:1.6rem;font-weight:800;color:var(--blue)}
    .qual .small{color:var(--muted);font-size:.9rem}

    .contact-box{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:2.5rem;max-width:640px;margin:0 auto}
    .contact-form{display:grid;gap:1rem;margin-top:1.5rem}
    .contact-form label{display:grid;gap:.4rem;font-weight:600;font-size:.95rem}
    .contact-form input,.contact-form select,.contact-form textarea{padding:.8rem 1rem;border:1px solid var(--border);border-radius:8px;font-size:1rem;font-family:inherit;background:var(--surface);color:var(--text)}
    .contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{outline:none;border-color:var(--sky)}

    .site-footer{background:var(--blue-dk);color:rgba(255,255,255,.75);padding:3rem 0 1.5rem}
    .footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem;margin-bottom:2rem}
    .footer-col h4{color:#fff;font-size:1rem;font-weight:700;margin-bottom:1rem}
    .footer-col p,.footer-col a{font-size:.9rem;color:rgba(255,255,255,.7);line-height:1.6}
    .footer-col a{display:block;margin-bottom:.5rem}
    .footer-col a:hover{color:#fff}
    .footer-bottom{text-align:center;border-top:1px solid rgba(255,255,255,.12);padding-top:1.5rem;font-size:.8rem;color:rgba(255,255,255,.5)}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="logo">Dronefoto<span>Aarhus</span></a>
      <nav aria-label="Hovednavigation">
        <a href="/">Forside</a>
        <a href="/ydelser">Ydelser</a>
        <a href="/galleri">Galleri</a>
        <a href="/om-os">Om os</a>
        <a href="/kontakt" class="nav-cta">Kontakt</a>
      </nav>
      <button class="nav-toggle" onclick="document.getElementById('mm').classList.toggle('open')" aria-label="Menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
    <div class="mobile-menu" id="mm">
      <a href="/">Forside</a>
      <a href="/ydelser">Ydelser</a>
      <a href="/galleri">Galleri</a>
      <a href="/om-os">Om os</a>
      <a href="/kontakt">Kontakt</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <h4>Dronefoto Aarhus</h4>
          <p>Din lokale leverandør af dronefotos, dronevideo og droneinspektion i Aarhus & Østjylland.</p>
        </div>
        <div class="footer-col">
          <h4>Ydelser</h4>
          <a href="/ydelser/dronefotografi">Dronefotografi</a>
          <a href="/ydelser/dronevideo">Dronevideo</a>
          <a href="/ydelser/droneinspektion">Droneinspektion</a>
          <a href="/ydelser/inspektion-af-landbrug">Inspektion af landbrug</a>
        </div>
        <div class="footer-col">
          <h4>Navigation</h4>
          <a href="/galleri">Galleri</a>
          <a href="/om-os">Om os</a>
          <a href="/kontakt">Kontakt</a>
        </div>
        <div class="footer-col">
          <h4>Kontakt</h4>
          <a href="mailto:info@dronefotoaarhus.dk">info@dronefotoaarhus.dk</a>
          <p>Aarhus C</p>
        </div>
      </div>
      <div class="footer-bottom">© {new Date().getFullYear()} Dronefoto Aarhus</div>
    </div>
  </footer>
</body>
</html>
